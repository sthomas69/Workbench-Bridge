<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WorkbenchBridge.Cli</RootNamespace>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Readable, hyphenated output name (cosmetic): Workbench-Bridge.Cli.exe.
         RootNamespace stays WorkbenchBridge.Cli, so no code/namespace change. -->
    <AssemblyName>Workbench-Bridge.Cli</AssemblyName>
    <!-- Semantic version; build number is appended at build time by
         Directory.Build.targets. See VERSIONING.md. -->
    <VersionPrefix>0.5.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkbenchBridge.Rfc2217\WorkbenchBridge.Rfc2217.csproj" />
    <ProjectReference Include="..\WorkbenchBridge.Service\WorkbenchBridge.Service.csproj" />
    <ProjectReference Include="..\WorkbenchBridge.Ipc\WorkbenchBridge.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
    <PackageReference Include="System.IO.Ports" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship a stub appsettings.Local.json.example alongside the CLI so users
         have a template to edit before running `configure`. -->
    <None Include="..\WorkbenchBridge.Service\appsettings.Local.json.example"
          Link="appsettings.Local.json.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ship the public defaults too, so direct commands (flash, device-info)
         can resolve Pi.Host/PortalPort and Tools.EsptoolPath without the
         service. Per-machine appsettings.Local.json overrides apply on top when
         present next to the exe or in the source tree (see CliConfig). -->
    <None Include="..\WorkbenchBridge.Service\appsettings.json"
          Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
